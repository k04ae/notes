#DEPENDENCY

class Sauce:
    def __init__(self, name, taste):
        self.name = name
        self.taste = taste
        print(self.name, "is ready")
    def __del__(self):
        print(self.name, "is ubos na")

class Tusoktusok:
    def __init__(self, name, sauce = None):
        self.name = name
        self.sauce = sauce
        print(self.name, "is cooked")
        if self.sauce != None:
            print("It is dipped in", self.sauce.name)
    def eat(self):
        print("I am eating", self.name)
        if self.sauce != None:
            print("It tastes", self.sauce.taste)
    def dip(self,sauce):
        self.sauce = sauce
        print(self.name, "was dipped in", self.sauce.name)
    def __del__(self):
        print(self.name, "was thrown in the trash can")

hotsauce = Sauce("Hot sauce", "spicy")
fishball = Tusoktusok("fishball", hotsauce)
fishball.eat()
del fishball

# CLASS
# A class is a blueprint for creating objects.

class Account:
    def __init__(self, account_number, account_holder, balance):
        self.account_number = account_number
        self.account_holder = account_holder
        self.balance = balance

    def deposit(self, amount):
        self.balance += amount

    def withdraw(self, amount):
        if amount <= self.balance:
            self.balance -= amount

    def get_balance(self):
        return self.balance


# INHERITANCE
# SavingsAccount inherits from Account.
# "SavingsAccount IS-A Account"

class SavingsAccount(Account):
    def __init__(self, account_number, account_holder, balance, interest_rate):
        super().__init__(account_number, account_holder, balance)
        self.interest_rate = interest_rate

    def add_interest(self):
        self.balance += self.balance * self.interest_rate


# COMPOSITION
# BankBranch HAS-A collection of Account objects.

class BankBranch:
    def __init__(self, branch_name):
        self.branch_name = branch_name
        self.accounts = []

    def add_account(self, account):
        self.accounts.append(account)

    def display_accounts(self):
        for account in self.accounts:
            print(account.account_number)
            print(account.account_holder)
            print(account.balance)


# OBJECTS
account1 = SavingsAccount("001", "Alex", 5000, 0.05)
account2 = SavingsAccount("002", "Jamie", 3000, 0.03)

# Using methods
account1.deposit(1000)
account1.withdraw(500)
account1.add_interest()

# Creating a BankBranch object
branch = BankBranch("Main Branch")

# Adding objects to the list
branch.add_account(account1)
branch.add_account(account2)

branch.display_accounts()


